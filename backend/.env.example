PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/veripool2
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin account created by `npm run seed` (paper's "Admin" stakeholder,
# who validates every registration before it can log in).
SEED_ADMIN_EMAIL=admin@veripool.app
SEED_ADMIN_PASSWORD=admin12345

# Optional: real, optimized routing via OpenRouteService — the same engine
# the paper uses (Sec. II-A). Free tier, no credit card:
# 1. Sign up at https://openrouteservice.org/dev/#/signup
# 2. Create a token (Directions API) and paste it below.
# Leave blank and the app falls back to a straight-line distance estimate —
# everything still works, just without real road routing.
ORS_API_KEY=

# Email OTP verification (registration) and account-decision emails, sent
# from the project's Gmail account. GMAIL_APP_PASSWORD is a 16-character
# App Password (Google Account -> Security -> 2-Step Verification -> App
# passwords) — NOT the real account password. Leave blank and OTP codes are
# logged to the backend console instead of emailed.
GMAIL_USER=veripool2026@gmail.com
GMAIL_APP_PASSWORD=
OTP_EXPIRY_MINUTES=10

# Claude API key for the AI customer care chat (console.anthropic.com -> API Keys).
# Leave blank and the Help chat falls back to the keyword FAQ bot.
ANTHROPIC_API_KEY=

# Night mode (24h clock, India time): drop-offs only at spots staffed all
# night, and tighter route-deviation alerts. FORCE_NIGHT_MODE=true turns it
# on all day — handy for demos.
NIGHT_START_HOUR=21
NIGHT_END_HOUR=6
FORCE_NIGHT_MODE=false
